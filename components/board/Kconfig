menu "Sipwire board"

    comment "Defaults = reference build (docs/HARDWARE.md). -1 = not connected."

    menu "Display (ILI9341, SPI)"
        config SIPWIRE_LCD_SPI_HOST
            int "SPI host (2=SPI2, 3=SPI3)"
            range 2 3
            default 2
        config SIPWIRE_LCD_SCLK
            int "SCLK"
            default 12
        config SIPWIRE_LCD_MOSI
            int "MOSI"
            default 11
        config SIPWIRE_LCD_MISO
            int "MISO (needed for touch)"
            default 13
        config SIPWIRE_LCD_CS
            int "LCD CS"
            default 10
        config SIPWIRE_LCD_DC
            int "LCD DC"
            default 14
        config SIPWIRE_LCD_RST
            int "LCD RST"
            default 9
        config SIPWIRE_LCD_BL
            int "Backlight"
            default 8
        config SIPWIRE_LCD_BL_ACTIVE_HIGH
            bool "Backlight active high"
            default y
        config SIPWIRE_LCD_PCLK_HZ
            int "LCD SPI clock (Hz)"
            default 40000000
        config SIPWIRE_LCD_H_RES
            int "Native horizontal resolution"
            default 240
        config SIPWIRE_LCD_V_RES
            int "Native vertical resolution"
            default 320
        config SIPWIRE_LCD_BGR
            bool "Panel uses BGR order"
            default y
        config SIPWIRE_LCD_INVERT
            bool "Invert colors"
            default n
        config SIPWIRE_LCD_MIRROR_X
            bool "Mirror X"
            default y
        config SIPWIRE_LCD_MIRROR_Y
            bool "Mirror Y"
            help
                Portrait upside down: toggle both Mirror X and Mirror Y (180°).
            default n
        config SIPWIRE_LCD_SWAP_XY
            bool "Swap XY (landscape)"
            default n
        config SIPWIRE_DISPLAY_PANEL_SLEEP
            bool "Put the panel to sleep while the backlight is off"
            default y
            help
                ILI9341 SLPIN when the backlight goes off (DC/DC, oscillator and panel
                scanning stop; frame memory and the SPI interface keep working, so LVGL
                may still flush into it), SLPOUT before it comes back on. The backlight
                is switched on only 120 ms after SLPOUT, so the panel's start-up is never
                visible. No effect in the QEMU build (no panel).
    endmenu

    menu "Touch (XPT2046, shares LCD SPI bus)"
        config SIPWIRE_TOUCH_ENABLE
            bool "Touch present"
            default y
        config SIPWIRE_TOUCH_CS
            int "Touch CS"
            depends on SIPWIRE_TOUCH_ENABLE
            default 16
        config SIPWIRE_TOUCH_IRQ
            int "Touch IRQ (PENIRQ)"
            depends on SIPWIRE_TOUCH_ENABLE
            default 17
        comment "Touch axes map raw XPT2046 X/Y to the screen, independent of the panel."
        config SIPWIRE_TOUCH_SWAP_XY
            bool "Touch: swap X/Y"
            depends on SIPWIRE_TOUCH_ENABLE
            default n
        config SIPWIRE_TOUCH_MIRROR_X
            bool "Touch: mirror X"
            depends on SIPWIRE_TOUCH_ENABLE
            default n
        config SIPWIRE_TOUCH_MIRROR_Y
            bool "Touch: mirror Y"
            depends on SIPWIRE_TOUCH_ENABLE
            default y
            help
                Reference build. Touch rotated 180 degrees: toggle both mirror options.
        config SIPWIRE_TOUCH_SPI_HZ
            int "Touch SPI clock (Hz)"
            depends on SIPWIRE_TOUCH_ENABLE
            default 2000000
        config SIPWIRE_TOUCH_RELEASE_DEBOUNCE_MS
            int "Touch release debounce (ms)"
            depends on SIPWIRE_TOUCH_ENABLE
            range 0 300
            default 80
            help
                A finger counts as lifted only after the panel reported no touch for this long.
                A resistive panel drops out for a read or two (~33 ms each) when a dragging finger
                eases off; without this, that early release turns a scroll into a tap on the item
                it started on. Taps are reported this much later. 0 = off.
    endmenu

    menu "Speaker (I2S DAC + amp)"
        config SIPWIRE_SPK_BCLK
            int "BCLK"
            default 15
        config SIPWIRE_SPK_WS
            int "WS / LRCLK"
            default 7
        config SIPWIRE_SPK_DOUT
            int "DOUT"
            default 6
        config SIPWIRE_SPK_EN
            int "Amp enable / shutdown pin (MAX98357A SD_MODE)"
            default 18
            help
                Driven "on" only while an audio stream plays (call, tone, ringtone,
                until the 2 s idle stop of a tone-only stream), "off" otherwise, also
                in light sleep. Between reset and audio_init() the pin is not driven:
                if the amp breakout pulls SD_MODE up, fit an external pull-down
                (docs/HARDWARE.md).
        config SIPWIRE_SPK_EN_ACTIVE_HIGH
            bool "Amp enable active high"
            default y
    endmenu

    menu "Microphone (I2S MEMS)"
        config SIPWIRE_I2S_FULL_DUPLEX
            bool "Mic shares speaker BCLK/WS (one I2S controller)"
            default y
        config SIPWIRE_MIC_BCLK
            int "BCLK"
            depends on !SIPWIRE_I2S_FULL_DUPLEX
            default 47
        config SIPWIRE_MIC_WS
            int "WS"
            depends on !SIPWIRE_I2S_FULL_DUPLEX
            default 21
        config SIPWIRE_MIC_DIN
            int "DIN (mic SD)"
            default 5
        config SIPWIRE_MIC_SLOT_RIGHT
            bool "Mic outputs on right slot (L/R pin high)"
            default n
        config SIPWIRE_MIC_SHIFT
            int "Right shift from 32-bit sample to 16-bit"
            range 8 20
            default 14
    endmenu

    menu "Echo cancellation"
        config SIPWIRE_AEC
            bool "Acoustic echo canceller on the mic path"
            default y
            help
                Cancels the speaker-to-mic echo with SpeexDSP's echo canceller
                (vendored in components/aec: adaptive MDF filter + residual
                echo suppressor). Switched live by the `aec` setting; off, the
                mic path is untouched.
        config SIPWIRE_AEC_TAIL
            int "Echo tail (samples at 16 kHz)"
            depends on SIPWIRE_AEC
            range 320 5120
            default 1280
            help
                Echo path length the adaptive filter models, rounded up to
                whole 20 ms frames (320 samples). The reference is read 160
                samples (10 ms) ahead of the nominal speaker->mic delay, so
                the default 1280 (80 ms) covers echo up to ~70 ms after it.
                Each 320 samples costs ~7.7 KB of RAM and a little CPU; the
                FFTs, which do not depend on the tail, dominate the cost.
                Echo beyond the tail is left to the residual suppressor.
    endmenu

    menu "Keypad (3x4 matrix)"
        config SIPWIRE_KP_ROW0
