            int "SDMMC D0"
            depends on SIPWIRE_SD_MODE_SDMMC
            default 38
            help
                Defaults are placeholders. Avoid strapping pins 0, 3, 45, 46.
        config SIPWIRE_SD_CS
            int "SPI CS"
            depends on SIPWIRE_SD_MODE_SPI
            default 47
        config SIPWIRE_SD_CD
            int "Card detect (-1 = none)"
            depends on SIPWIRE_SD_ENABLE
            default -1
    endmenu

    menu "Power (components/power)"
        config SIPWIRE_WIFI_LISTEN_INTERVAL
            int "Wi-Fi listen interval while idle (beacons; 1 = every DTIM)"
            range 1 10
            default 3
            help
                Wi-Fi power save while no call exists (components/net). 1: WIFI_PS_MIN_MODEM,
                the radio wakes for every DTIM beacon. 2-10: WIFI_PS_MAX_MODEM, it wakes
                every this many beacons (the listen interval is announced to the AP when
                associating). Calls always use WIFI_PS_NONE.
                Trade-off: the AP holds an incoming INVITE until the next wake-up, so
                ringing may start up to listen interval x beacon interval later (3 x
                102.4 ms = 0.3 s; 10 = 1 s, then SIP T1 retransmits the INVITE once).
                Broadcasts (ARP requests from the PBX or router) come only at DTIM
                beacons and are missed when the listen interval skips them: keep it a
                multiple of the AP's DTIM period.
        config SIPWIRE_POWER_DFS
            bool "Dynamic CPU frequency scaling while idle"
            depends on PM_ENABLE
            default y
            help
                Run the CPU at the minimum frequency below when no call exists and
                the backlight is off; full speed otherwise. Wi-Fi modem sleep while
                idle is separate (net, SIPWIRE_WIFI_LISTEN_INTERVAL) and always on.
                Light sleep: next option (docs/ARCHITECTURE.md "Power").
        config SIPWIRE_POWER_MIN_CPU_MHZ
            int "Idle CPU frequency (MHz): 80, 160 or 240"
            depends on SIPWIRE_POWER_DFS
            range 80 240
            default 80
            help
                Not below 80: under 80 MHz the CPU runs from XTAL and APB drops to
                40 MHz, which changes the UART, LEDC (backlight PWM) and other
                APB-clocked peripherals mid-operation.
        config SIPWIRE_POWER_LIGHT_SLEEP
            bool "Automatic light sleep while idle (screen off, no call)"
            depends on SIPWIRE_POWER_DFS && FREERTOS_USE_TICKLESS_IDLE
            select PM_LIGHT_SLEEP_CALLBACKS
            default n
            help
                Off by default: on the handset (octal PSRAM), once the chip had light-slept,
                answering or ending a call sometimes crashed it (PSRAM "MMU entry fault",
                or a hang in the panic handler with the flash cache off, then a watchdog
                reset), also after `power sleep off`. Never with this option off.
                Let the chip light-sleep whenever both cores idle and nothing holds it
                awake: never during a call (ringing included), while the backlight is
                on or dimmed, or within SIPWIRE_POWER_CONSOLE_AWAKE_S of console input.
                Wi-Fi stays associated in modem sleep and wakes for each DTIM beacon, so
                an INVITE still arrives within one DTIM interval. Wake sources: keypad
                columns and touch PENIRQ (GPIO, level low), console UART RX edges (the
                characters that wake it are lost). Needs FREERTOS_USE_TICKLESS_IDLE.
        config SIPWIRE_POWER_CONSOLE_AWAKE_S
            int "Stay awake this long after console input (s)"
            depends on SIPWIRE_POWER_LIGHT_SLEEP
            range 5 3600
            default 60
            help
                A character that arrives during light sleep only wakes the chip; it
                is not received. After a UART wake-up or any console input, light
                sleep stays off for this many seconds so the rest of the line and
                the next commands get through.
    endmenu

    config SIPWIRE_QEMU
        bool "QEMU smoke-test build"
        default n
        help
            Test-only. Networking uses QEMU's OpenCores Ethernet instead of
            Wi-Fi, and audio replaces I2S with paced silence. Set by
            sdkconfig.qemu (see tools/qemu/README.md); never on hardware.

endmenu
