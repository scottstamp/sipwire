# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# CPU: 240 MHz for G.722 + LVGL + Wi-Fi headroom (default 160)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL 9
CONFIG_LV_COLOR_FORMAT_RGB565=y
# lv_malloc from the ESP heap: the 64 KB builtin pool ran out drawing
# transformed widgets (NULL layer buffer → crash).
# LVGL heap in PSRAM (components/display/lv_mem_psram.c), not internal RAM
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_PERF_MONITOR=n
# LVGL's examples and demos use widgets disabled below (and are never linked): don't build them.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# Unused LVGL modules off (flash): only label, button, bar, buttonmatrix, dropdown, keyboard,
# slider, switch, textarea, image, flex and the default theme are used. Re-enable here (and in
# sim/web/lv_conf.h) when a screen needs one.
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARC is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_SPINNER is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_GRID is not set
# CONFIG_LV_USE_OBSERVER is not set
# CONFIG_LV_USE_THEME_MONO is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set

# XPT2046 touch (components/display): PENIRQ only works in "interrupt" (power-down) mode;
# raw ADC values are converted/calibrated in display.c, not by the driver.
CONFIG_XPT2046_INTERRUPT_MODE=y
CONFIG_XPT2046_CONVERT_ADC_TO_COORDS=n

# Console: `tasks` command (vTaskList), `cpu` command (run-time stats)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# ESP32-S3-WROOM-1-N16R8: 16 MB quad flash, 8 MB octal PSRAM (in-package,
# uses GPIO 35-37). Large heap allocations (LVGL, jitter buffers) spill to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Boards of this class without PSRAM still boot (internal RAM only).
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Partitions: wifi + LVGL no longer fit the 1 MB default app slot
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# Quad I/O flash at 80 MHz (the module's quad flash; was DIO). The 2nd-stage bootloader sets
# the QE bit and switches the cache to QIO, so a unit needs the bootloader flashed over serial
# once; OTA alone keeps the old DIO bootloader and esp_https_ota refuses a QIO image on a DIO
# app (ESP_HTTPS_OTA_VERIFY_SPI_MODE). docs/ARCHITECTURE.md "Flash mode".
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA (components/ota): plain http for the LAN update server (default
# CONFIG_SIPWIRE_OTA_URL); a new image boots PENDING_VERIFY and must be marked valid
# (ota.h: UI up + network, or 60 s) or the bootloader rolls back to the previous slot.
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Stacks: settings_t grew (NTP/TZ/OTA fields) and a few event handlers keep one on the stack
# (net, display); the bridge restarts SNTP from the event loop task.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3584
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# Memory placement (docs/ARCHITECTURE.md "Memory and tasks"). mbedTLS buffers (TLS record
# buffers 16 KB in + 4 KB out per session, handshake/cert state; WPA supplicant crypto) come
# from PSRAM: only task context uses them (https OTA task, Wi-Fi task), never an ISR.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# `tasks` shows each task's core (-1 = no affinity)
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# IPC tasks (ipc0/ipc1, IDF-internal cross-core calls): the 1280 default left only 228 B
# free on ipc0 in the QEMU smoke test (during a call); +768 B each.
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048

# Power (components/power, docs/ARCHITECTURE.md "Power"): dynamic frequency scaling. The CPU
# drops to CONFIG_SIPWIRE_POWER_MIN_CPU_MHZ (80) only with no call and the backlight off.
CONFIG_PM_ENABLE=y
# Lock and mode counters: `power locks` shows the time spent at each CPU frequency.
CONFIG_PM_PROFILING=y
# Automatic light sleep (CONFIG_SIPWIRE_POWER_LIGHT_SLEEP, default n: see its help) needs tickless idle (it
# selects PM_LIGHT_SLEEP_CALLBACKS: console wake-up, `power` sleep stats). The QEMU overlay
# turns PM_ENABLE off, which drops them.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# Wi-Fi roaming (components/net, board Kconfig "Wi-Fi roaming and range warning"):
# SIPWIRE_WIFI_BTM selects ESP_WIFI_11KV_SUPPORT for 802.11v BSS transition; the 802.11k half
# stays off: an AP's beacon report requests would make the handset scan during calls.
# CONFIG_ESP_WIFI_RRM_SUPPORT is not set
# DHCP: no ARP probe of the offered address before using it. Every reconnect (roam, link lost
# during a call) does a full DHCP exchange, and the probe added a fixed 500 ms of silence to
# each; DHCP servers check for conflicts before offering anyway.
CONFIG_LWIP_DHCP_DOES_NOT_CHECK_OFFERED_IP=y
