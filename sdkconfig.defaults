# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# CPU: 240 MHz for G.722 + LVGL + Wi-Fi headroom (default 160)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Compiler
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL 9
CONFIG_LV_COLOR_FORMAT_RGB565=y
# lv_malloc from the ESP heap: the 64 KB builtin pool ran out drawing
# transformed widgets (NULL layer buffer → crash).
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_LEVEL_WARN=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_PERF_MONITOR=n

# XPT2046 touch (components/display): PENIRQ only works in "interrupt" (power-down) mode;
# raw ADC values are converted/calibrated in display.c, not by the driver.
CONFIG_XPT2046_INTERRUPT_MODE=y
CONFIG_XPT2046_CONVERT_ADC_TO_COORDS=n

# Console: `tasks` command (vTaskList)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y

# ESP32-S3-WROOM-1-N16R8: 16 MB quad flash, 8 MB octal PSRAM (in-package,
# uses GPIO 35-37). Large heap allocations (LVGL, jitter buffers) spill to PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Boards of this class without PSRAM still boot (internal RAM only).
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Partitions: wifi + LVGL no longer fit the 1 MB default app slot
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
